# Copy this to .env.local and fill in your values

# Admin credentials (set these for your admin login)
ADMIN_EMAIL=admin@thegistdecatur.com
ADMIN_PASSWORD=your-secure-password-here

# JWT secret for admin sessions (generate a random 32+ char string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Unosend API settings (configure in Admin > Settings UI, or preset here)
UNOSEND_API_KEY=
UNOSEND_LIST_ID=
UNOSEND_FROM_EMAIL=newsletter@thegistdecatur.com
UNOSEND_FROM_NAME=The Gist Decatur

# Database (SQLite - leave as-is for local dev)
DATABASE_URL="file:./dev.db"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
