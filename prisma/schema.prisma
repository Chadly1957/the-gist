generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Source {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  articleUrl  String   @unique
  sourceName  String
  publishedAt DateTime
  scrapedAt   DateTime @default(now())
  selected    Boolean  @default(false)
}

model Template {
  id        String   @id @default(cuid())
  name      String
  blocks    String   // JSON array of block objects
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String?
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model NewsletterSend {
  id             String                 @id @default(cuid())
  subject        String
  htmlBody       String
  htmlSnapshot   String?
  sentAt         DateTime               @default(now())
  recipientCount Int                    @default(0)
  status         String                 @default("sent")
  recipients     NewsletterRecipient[]
}

model NewsletterRecipient {
  id               String         @id @default(cuid())
  newsletterSendId String
  newsletterSend   NewsletterSend @relation(fields: [newsletterSendId], references: [id], onDelete: Cascade)
  subscriberId     String?
  email            String
  resendEmailId    String?
  openedAt         DateTime?
  openCount        Int            @default(0)
  clickedAt        DateTime?
  clickCount       Int            @default(0)
  unsubscribedAt   DateTime?
  createdAt        DateTime       @default(now())
  clicks           LinkClick[]

  @@index([newsletterSendId])
}

model LinkClick {
  id                     String              @id @default(cuid())
  newsletterRecipientId  String
  newsletterRecipient    NewsletterRecipient @relation(fields: [newsletterRecipientId], references: [id], onDelete: Cascade)
  url                    String
  linkType               String // article | button | spotlight | presenting_sponsor | in_article_ad
  label                  String?
  createdAt              DateTime            @default(now())

  @@index([newsletterRecipientId])
}

model SponsorProfile {
  id           String             @id @default(cuid())
  businessName String
  contactName  String
  email        String             @unique
  phone        String?
  website      String?
  magicToken   String             @unique @default(cuid())
  active       Boolean            @default(true)
  notes        String?
  createdAt    DateTime           @default(now())
  spotlights   SpotlightListing[]
  bookings     AdBooking[]
}

model SpotlightListing {
  id           String         @id @default(cuid())
  sponsorId    String
  sponsor      SponsorProfile @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  businessName String
  logoUrl      String?
  description  String
  ctaLabel     String         @default("Visit Website")
  ctaUrl       String
  status       String         @default("pending")
  lastShownAt  DateTime?
  shownCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  approvedAt   DateTime?
}

model AdBooking {
  id              String         @id @default(cuid())
  sponsorId       String
  sponsor         SponsorProfile @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  type            String
  date            String
  status          String         @default("pending_review")
  isPaid          Boolean        @default(false)
  imageUrl        String?
  headline        String
  body            String
  ctaUrl          String
  ctaLabel        String         @default("Learn More")
  presentingBlurb String?
  adminNotes      String?
  createdAt       DateTime       @default(now())
  approvedAt      DateTime?
}
