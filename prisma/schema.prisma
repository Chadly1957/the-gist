generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                          String                    @id @default(cuid())
  slug                        String                    @unique
  name                        String
  area                        String
  domain                      String?                   @unique
  latitude                    Float?
  longitude                   Float?
  timezone                    String?
  primaryColor                String                    @default("#15803d")
  secondaryColor              String                    @default("#166534")
  logoUrl                     String?
  heroImageUrl                String?
  dealsLogoUrl                String?
  dealsEmailHeaderUrl         String?
  createdAt                   DateTime                  @default(now())
  sourceRows                  Source[]
  articleRows                 Article[]
  templateRows                Template[]
  subscriberRows              Subscriber[]
  settingRows                 Setting[]
  newsletterSendRows          NewsletterSend[]
  newsletterSendSpotlightRows NewsletterSendSpotlight[]
  newsletterRecipientRows     NewsletterRecipient[]
  linkClickRows               LinkClick[]
  sponsorProfileRows          SponsorProfile[]
  spotlightListingRows        SpotlightListing[]
  adBookingRows               AdBooking[]
  sponsorWeekRows             SponsorWeek[]
  sponsorHoldRows             SponsorHold[]
  sponsorWeekBookingRows      SponsorWeekBooking[]
  sponsorEmailTemplateRows    SponsorEmailTemplate[]
  sponsorEmailCampaignRows    SponsorEmailCampaign[]
  sponsorDayConfigRows        SponsorDayConfig[]
  gameSponsorEventRows        GameSponsorEvent[]
  eventRows                   Event[]
  referralSprintRows          ReferralSprint[]
  referralCodeRows            ReferralCode[]
  referralSignupRows          ReferralSignup[]
  wordyWordRows               WordyWord[]
  wordyBookingRows            WordyBooking[]
  wordyPlayRows               WordyPlay[]
  matchScoreRows              MatchScore[]
  joinTestEventRows           JoinTestEvent[]
  pollRows                    Poll[]
  pollOptionRows              PollOption[]
  pollVoteRows                PollVote[]
  tipRows                     Tip[]
  couponBookPurchaseRows      CouponBookPurchase[]
  couponRows                  Coupon[]
  couponRedemptionRows        CouponRedemption[]
  retailerRows                Retailer[]
  dealWeekRows                DealWeek[]
  dealRows                    Deal[]
  dealDigestSendRows          DealDigestSend[]
  dealsNurtureTouchRows       DealsNurtureTouch[]
  productRows                 Product[]
  productOrderRows            ProductOrder[]
  storyRows                   Story[]
  boardPostRows               BoardPost[]
  miniRows                      Mini[]
  miniPurchaseRows              MiniPurchase[]
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Source {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  name        String
  url         String
  active      Boolean   @default(true)
  keywords    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, url])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Article {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  articleUrl  String
  sourceName  String
  publishedAt DateTime
  scrapedAt   DateTime  @default(now())
  selected    Boolean   @default(false)
  tags        String[]  @default([])

  @@unique([workspaceId, articleUrl])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Template {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  name        String
  blocks      String // JSON array of block objects
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Subscriber {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String    @id @default(cuid())
  email        String
  firstName    String?
  subscribedAt DateTime  @default(now())
  active       Boolean   @default(true)
  // First-touch acquisition, captured at signup from the /join URL and the
  // browser referrer. Null for every subscriber who joined before this
  // shipped: UTM capture is forward-only and never backfilled.
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referrer     String?
  // Opt-out of the post-signup Deals nurture email sequence (stays subscribed
  // to the newsletter itself).
  dealsNurtureOptOut Boolean @default(false)

  @@unique([workspaceId, email])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// A/B test events for the /join landing page (view + signup per variant).
model JoinTestEvent {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  variant     String
  event       String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, variant, event])
  @@index([createdAt])
}

model Setting {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  key         String
  value       String

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model NewsletterSend {
  workspaceId            String                    @default("decatur")
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                     String                    @id @default(cuid())
  subject                String
  htmlBody               String
  htmlSnapshot           String?
  sentAt                 DateTime                  @default(now())
  recipientCount         Int                       @default(0)
  status                 String                    @default("sent")
  sponsorAnalyticsSentAt DateTime?
  recipients             NewsletterRecipient[]
  spotlightAppearances   NewsletterSendSpotlight[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model NewsletterSendSpotlight {
  workspaceId      String           @default("decatur")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String           @id @default(cuid())
  newsletterSendId String
  newsletterSend   NewsletterSend   @relation(fields: [newsletterSendId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  spotlightId      String
  spotlight        SpotlightListing @relation(fields: [spotlightId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([newsletterSendId])
  @@index([spotlightId])
  @@index([workspaceId])
}

model NewsletterRecipient {
  workspaceId      String         @default("decatur")
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String         @id @default(cuid())
  newsletterSendId String
  newsletterSend   NewsletterSend @relation(fields: [newsletterSendId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  subscriberId     String?
  email            String
  resendEmailId    String?
  openedAt         DateTime?
  openCount        Int            @default(0)
  clickedAt        DateTime?
  clickCount       Int            @default(0)
  unsubscribedAt   DateTime?
  createdAt        DateTime       @default(now())
  clicks           LinkClick[]

  @@unique([id, workspaceId])
  @@index([newsletterSendId])
  @@index([workspaceId])
}

model LinkClick {
  workspaceId           String              @default("decatur")
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                    String              @id @default(cuid())
  newsletterRecipientId String
  newsletterRecipient   NewsletterRecipient @relation(fields: [newsletterRecipientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  url                   String
  linkType              String // article | button | spotlight | presenting_sponsor | in_article_ad
  label                 String?
  createdAt             DateTime            @default(now())

  @@unique([id, workspaceId])
  @@index([newsletterRecipientId])
  @@index([workspaceId])
}

model SponsorProfile {
  workspaceId   String               @default("decatur")
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id            String               @id @default(cuid())
  businessName  String
  contactName   String
  email         String
  phone         String?
  website       String?
  logoUrl       String?
  magicToken    String               @unique @default(cuid())
  active        Boolean              @default(true)
  nurtureOptOut Boolean              @default(false)
  notes         String?
  createdAt     DateTime             @default(now())
  spotlights    SpotlightListing[]
  bookings      AdBooking[]
  weekBookings  SponsorWeekBooking[]
  events        Event[]
  wordyBookings WordyBooking[]
  coupons       Coupon[]
  retailers     Retailer[]

  @@unique([id, workspaceId])
  // One person can own several businesses: email alone is not unique.
  // Find-or-create flows match on email + business name.
  @@index([workspaceId, email])
  @@index([workspaceId])
}

// Sponsor nurture emails (Admin > Sponsors > Nurture): reusable base
// templates plus per-send campaigns built from them, emailed to free
// businesses to nurture them toward paid sponsorship. Blocks are stored
// as a JSON string (same pattern as the newsletter Template model).
model SponsorEmailTemplate {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  name        String
  subject     String    @default("")
  blocks      String    @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model SponsorEmailCampaign {
  workspaceId    String    @default("decatur")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String    @id @default(cuid())
  templateId     String?
  name           String
  subject        String    @default("")
  blocks         String    @default("[]")
  audience       String    @default("free") // free | all | past
  status         String    @default("draft") // draft | sending | sent
  sentAt         DateTime?
  recipientCount Int       @default(0)
  failedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model SpotlightListing {
  workspaceId        String                    @default("decatur")
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                 String                    @id @default(cuid())
  sponsorId          String
  sponsor            SponsorProfile            @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  businessName       String
  logoUrl            String?
  description        String
  ctaLabel           String                    @default("Visit Website")
  ctaUrl             String
  status             String                    @default("pending")
  category           String?
  lastShownAt        DateTime?
  shownCount         Int                       @default(0)
  upgradeNudgeSentAt DateTime?
  createdAt          DateTime                  @default(now())
  approvedAt         DateTime?
  sendAppearances    NewsletterSendSpotlight[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model AdBooking {
  workspaceId          String              @default("decatur")
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                   String              @id @default(cuid())
  sponsorId            String
  sponsor              SponsorProfile      @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  type                 String
  date                 String
  status               String              @default("pending_review")
  isPaid               Boolean             @default(false)
  // $0 comp/house placement (spec section 12). Marked in admin only; the
  // newsletter renders it like any other ad.
  isComp               Boolean             @default(false)
  discountPct          Int                 @default(0)
  stripeSessionId      String?
  imageUrl             String?
  headline             String
  body                 String
  ctaUrl               String
  ctaLabel             String              @default("Learn More")
  presentingBlurb      String?
  adminNotes           String?
  // Set when this row was projected from a week-based SponsorWeekBooking.
  sponsorWeekBookingId String?
  sponsorWeekBooking   SponsorWeekBooking? @relation(fields: [sponsorWeekBookingId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  approvedAt           DateTime?
  gameSponsorEvents    GameSponsorEvent[]

  @@unique([id, workspaceId])
  @@index([stripeSessionId])
  @@index([workspaceId])
  @@index([sponsorWeekBookingId])
}

model SponsorDayConfig {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  date         String // YYYY-MM-DD of the newsletter issue
  maxInArticle Int       @default(2) // per-issue standard-slot override (soft cap)
  createdAt    DateTime  @default(now())

  @@id([workspaceId, date])
  @@index([workspaceId])
}

// Week-based sponsor packages (Presenting $150/wk, Standard $75/wk).
// One row per calendar week (Monday date string); the row doubles as the
// lock target for atomic slot assignment (SELECT ... FOR UPDATE).
model SponsorWeek {
  workspaceId String               @default("decatur")
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String               @id @default(cuid())
  weekStart   String // Monday, YYYY-MM-DD
  createdAt   DateTime             @default(now())
  holds       SponsorHold[]
  bookings    SponsorWeekBooking[]

  @@unique([workspaceId, weekStart])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// Short-lived slot reservation while the buyer fills the business form.
model SponsorHold {
  workspaceId String      @default("decatur")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String      @id @default(cuid())
  weekId      String
  week        SponsorWeek @relation(fields: [weekId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tier        String // "presenting" | "standard"
  holdToken   String      @unique @default(cuid())
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([expiresAt])
}

model SponsorWeekBooking {
  workspaceId            String         @default("decatur")
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                     String         @id @default(cuid())
  weekId                 String
  week                   SponsorWeek    @relation(fields: [weekId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sponsorId              String
  sponsor                SponsorProfile @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tier                   String // "presenting" | "standard"
  status                 String         @default("pending_payment") // pending_payment -> paid -> completed | cancelled
  amountCents            Int
  stripeSessionId        String?
  businessName           String
  contactName            String
  email                  String
  website                String?
  logoUrl                String
  aboutText              String
  chadWritesCopy         Boolean        @default(true)
  finalAdCopy            String?
  copyFinalizedAt        DateTime?
  rebookToken            String         @unique @default(cuid())
  resultsSentAt          DateTime?
  renewalSentAt          DateTime?
  paidAt                 DateTime?
  ownerNotifiedAt        DateTime?
  buyerNotifiedAt        DateTime?
  fulfillmentAlertSentAt DateTime?
  createdAt              DateTime       @default(now())
  adBookingRows          AdBooking[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([stripeSessionId])
  @@index([weekId])
  @@index([status])
}

model GameSponsorEvent {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  game        String // "wordy" | "match"
  eventType   String // "impression" | "click"
  bookingId   String
  booking     AdBooking @relation(fields: [bookingId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([date])
  @@index([bookingId])
  @@index([game])
  @@index([workspaceId])
}

model Event {
  workspaceId String          @default("decatur")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String          @id @default(cuid())
  title       String
  description String?
  eventDate   String
  startTime   String?
  endTime     String?
  location    String?
  url         String?
  cost        String?
  status      String          @default("pending")
  sponsorId   String?
  sponsor     SponsorProfile? @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  approvedAt  DateTime?

  @@unique([id, workspaceId])
  @@index([sponsorId])
  @@index([workspaceId])
}

model ReferralSprint {
  workspaceId      String           @default("decatur")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String           @id @default(cuid())
  name             String
  startDate        String
  endDate          String
  goal             Int              @default(5)
  prizeDescription String?
  status           String           @default("active")
  winnerEmail      String?
  drawnAt          DateTime?
  createdAt        DateTime         @default(now())
  signups          ReferralSignup[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model ReferralCode {
  workspaceId  String           @default("decatur")
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String           @id @default(cuid())
  subscriberId String           @unique
  code         String           @unique
  createdAt    DateTime         @default(now())
  signups      ReferralSignup[]

  @@unique([id, workspaceId])
  @@index([code])
  @@index([workspaceId])
}

model ReferralSignup {
  workspaceId     String          @default("decatur")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String          @id @default(cuid())
  referralCodeId  String
  referralCode    ReferralCode    @relation(fields: [referralCodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  newSubscriberId String?
  sprintId        String?
  sprint          ReferralSprint? @relation(fields: [sprintId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdAt       DateTime        @default(now())

  @@unique([id, workspaceId])
  @@index([referralCodeId])
  @@index([sprintId])
  @@index([workspaceId])
}

model WordyWord {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  word        String
  puzzleNum   Int?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, date])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model WordyBooking {
  workspaceId     String         @default("decatur")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String         @id @default(cuid())
  date            String
  sponsorId       String
  sponsor         SponsorProfile @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  headline        String
  body            String         @default("")
  ctaUrl          String         @default("")
  ctaLabel        String         @default("Learn More")
  imageUrl        String?
  presentingBlurb String?
  status          String         @default("pending_review")
  isPaid          Boolean        @default(false)
  stripeSessionId String?
  adminNotes      String?
  createdAt       DateTime       @default(now())
  approvedAt      DateTime?

  @@unique([workspaceId, date])
  @@unique([id, workspaceId])
  @@index([sponsorId])
  @@index([stripeSessionId])
  @@index([workspaceId])
}

model WordyPlay {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  recipientId String?
  won         Boolean
  guesses     Int
  maxGuesses  Int
  wordLength  Int
  createdAt   DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([date])
  @@index([workspaceId])
}

model MatchScore {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  deviceId    String
  name        String
  score       Int
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, date, deviceId])
  @@unique([id, workspaceId])
  @@index([date])
  @@index([workspaceId])
}

model Poll {
  workspaceId      String       @default("decatur")
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  question         String
  newsletterSendId String?
  createdAt        DateTime     @default(now())
  options          PollOption[]
  votes            PollVote[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model PollOption {
  workspaceId String     @default("decatur")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  label       String
  sortOrder   Int        @default(0)
  votes       PollVote[]

  @@unique([id, workspaceId])
  @@index([pollId])
  @@index([workspaceId])
}

model PollVote {
  workspaceId String     @default("decatur")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  optionId    String
  option      PollOption @relation(fields: [optionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  recipientId String?
  createdAt   DateTime   @default(now())

  @@unique([pollId, recipientId])
  @@unique([id, workspaceId])
  @@index([pollId])
  @@index([optionId])
  @@index([workspaceId])
}

model Tip {
  workspaceId     String    @default("decatur")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String    @id @default(cuid())
  amountCents     Int
  source          String    @default("web") // "web" | "newsletter" | "wordy" | "match"
  status          String    @default("pending_payment") // pending_payment | paid
  stripeSessionId String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@unique([id, workspaceId])
  @@index([stripeSessionId])
  @@index([status])
  @@index([workspaceId])
}

// Products: things a workspace sells (Decatur-opoly, future merch, etc.).
// Created in admin; each active product gets a public marketing page at
// /products/<slug> and a Stripe Checkout flow fulfilled by the webhook.
model Product {
  workspaceId     String         @default("decatur")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String         @id @default(cuid())
  name            String
  slug            String
  tagline         String?
  description     String?        // marketing copy, plain text paragraphs
  priceCents      Int
  compareAtCents  Int?           // strikethrough "was" price, optional
  imageUrl        String?        // hero image
  galleryUrls     String[]       @default([])
  fulfillmentNote String?        // e.g. "Pre-order: ships when the run prints"
  quantity        Int?           // total available; null = unlimited. Sold out when paid orders reach it
  requiresShipping Boolean       @default(true) // physical products collect a shipping address at checkout; digital ones do not
  offersSizes     Boolean        @default(false) // when true, buyers must pick an apparel size (fixed set in lib/product-sizes.ts) before checkout
  stripePaymentLinkId String?    // legacy Stripe Payment Link (plink_...) whose sales file under this product
  status          String         @default("draft") // draft | active | archived
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orders          ProductOrder[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([stripePaymentLinkId])
}

model ProductOrder {
  workspaceId     String    @default("decatur")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  email           String
  amountCents     Int
  stripeSessionId String?   @unique
  status          String    @default("pending_payment") // pending_payment | paid
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  // Set from the admin Products page when an order ships, so the admin
  // notification bell can clear it. Null = paid but not yet fulfilled.
  fulfilledAt     DateTime?
  // Shipping address captured from the Stripe Checkout session at payment
  // time, stored for fulfillment. Null when the product does not require
  // shipping or the session collected no address (e.g. older orders).
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  // Apparel size the buyer picked at checkout, when the product offers
  // size selection (fixed set in lib/product-sizes.ts). Null for products
  // without sizes and for orders placed before sizes existed.
  size               String?

  @@unique([id, workspaceId])
  @@index([productId])
  @@index([workspaceId, status])
}

// Original articles written in the admin (the CMS behind /articles), e.g.
// the community-seeded briefs. NOT the scraped Article pool above: those
// rows are external links curated into issues; a Story is first-party
// content published on the Gist's own site, with its own RSS feed so the
// Source tab can pull it into the pool like any other source.
model Story {
  workspaceId    String    @default("decatur")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String    @id @default(cuid())
  headline       String
  slug           String
  author         String    @default("Chad Williams")
  headerImageUrl String?
  body           String // rich text HTML from the admin editor, sanitized on save
  excerpt        String? // summary; auto-derived from the body when left blank
  status         String    @default("draft") // draft | published
  publishedAt    DateTime? // stamped when the story first goes published
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, publishedAt])
}

// Presenting Partnerships: annual sponsorships billed monthly via Stripe.
// Workspace-agnostic by design: one partnership can cover one city or both.
model PresentingPartnership {
  id                   String    @id @default(cuid())
  businessName         String
  contactName          String
  email                String
  category             String    // dining | banking | auto | healthcare | home_services | retail
  tier                 String    // "one_city" | "both_cities"
  workspaceIds         String[]  @default([]) // city workspaces this covers, e.g. ["decatur"]
  monthlyAmountCents   Int       // 33333 = $333.33/mo (one city), 58333 = $583.33/mo (both)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  status               String    @default("pending_payment") // pending_payment | active | past_due | cancelled
  startDate            DateTime  @default(now())
  cancelledAt          DateTime?
  // Ad creative profile: filled in at setup, goes live when paid.
  sponsorProfileId     String?
  logoUrl              String?
  website              String?
  headline             String?
  body                 String?
  ctaLabel             String?
  ctaUrl               String?
  imageUrl             String?   // feature image for the rotating spotlight
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([stripeCustomerId])
}

model CouponBookPurchase {
  workspaceId     String             @default("decatur")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String             @id @default(cuid())
  email           String
  stripeSessionId String?            @unique
  // Unguessable token encoded in the buyer's QR code; the cashier page needs
  // no login, so this token is the only credential. Keep it private.
  buyerToken      String             @unique @default(cuid())
  // Emailed magic link for the reader dashboard (no passwords).
  magicToken      String             @unique @default(cuid())
  active          Boolean            @default(true)
  // Lifetime access: one-time $15 buyers are grandfathered in free if the book
  // ever moves to a subscription. All one-time purchases get this.
  isLifetime      Boolean            @default(true)
  // Annual billing for NEW purchases (2026-10-29 switch): a $15/year Stripe
  // subscription, or a prepaid gift year. Non-lifetime rows carry access
  // through accessUntil (the paid-through date); lifetime rows ignore these
  // fields entirely. subscriptionStatus is Stripe's status string; it stays
  // null for rows with no Stripe subscription (lifetime rows, gift years).
  stripeSubscriptionId String?        @unique
  subscriptionStatus   String?
  accessUntil          DateTime?
  cancelAtPeriodEnd    Boolean        @default(false)
  // Weekly deals digest: buyers get the fresh book in their inbox every week
  // unless they opt out (footer link in each digest).
  digestOptOut    Boolean            @default(false)
  createdAt       DateTime           @default(now())
  redemptions     CouponRedemption[]

  @@unique([id, workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId])
}

model Coupon {
  workspaceId    String             @default("decatur")
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String             @id @default(cuid())
  businessName   String
  title          String
  description    String             @default("")
  terms          String             @default("")
  // 1 = one-time use, null = unlimited recurring. Enforced server-side.
  maxRedemptions Int?
  // Renewing coupon: "daily" | "weekly" | "monthly" — one redemption per interval,
  // auto-refreshes. Null = legacy maxRedemptions behavior.
  refreshInterval String?
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  contactEmail   String?
  // True = redeemed online/via email (buyer shares the link); false = in-store QR scan.
  onlineRedemption Boolean @default(false)
  createdAt      DateTime           @default(now())
  redemptions    CouponRedemption[]
  // Self-serve portal submission: null = created by admin in the coupon book flow.
  sponsorId      String?
  sponsor        SponsorProfile?    @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model CouponRedemption {
  workspaceId String             @default("decatur")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String             @id @default(cuid())
  couponId    String
  coupon      Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    CouponBookPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime           @default(now())
  // Optional note the cashier adds at scan time (new per-coupon QR flow).
  notes       String             @default("")

  @@unique([id, workspaceId])
  @@index([couponId])
  @@index([purchaseId])
  @@index([workspaceId])
}

// Coupon book content engine: weekly retailer deals (Phase 1).
// Retailers are configured per workspace; national content (Hobby Lobby) is
// seeded per workspace too so the unique constraints stay uniform.
model Retailer {
  workspaceId          String     @default("decatur")
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                   String     @id @default(cuid())
  slug                 String
  displayName          String
  // Retailer brand logo for the Deals Book bento UI (Chad approved using brand logos).
  logoUrl              String?
  // Self-serve sponsor deals: null = Chad-managed retailer, set = this sponsor's own deals section.
  sponsorId            String?
  sponsor              SponsorProfile? @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // hobby-lobby | target | aldi | dollar-general | kroger | manual
  pipeline             String
  // JSON: { zip, storeId, locationId } — whatever the pipeline needs.
  storeConfig          String     @default("{}")
  affiliateUrlTemplate String?
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())
  dealWeeks            DealWeek[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model DealWeek {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  retailerId  String
  retailer    Retailer  @relation(fields: [retailerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  weekStart   String // YYYY-MM-DD (Monday)
  weekEnd     String
  sourceUrl   String?
  // draft | published
  status      String    @default("draft")
  fetchedAt   DateTime  @default(now())
  publishedAt DateTime?
  deals       Deal[]

  @@unique([workspaceId, retailerId, weekStart])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

model Deal {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String    @id @default(cuid())
  dealWeekId   String
  dealWeek     DealWeek  @relation(fields: [dealWeekId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Our own wording — prices/facts aren't copyrightable, but we paraphrase
  // retailer headlines rather than copying ad copy verbatim.
  title        String
  price        String?
  regPrice     String?
  category     String?
  summary      String    @default("")
  // Deep link to the retailer's own ad page for this deal/week.
  dealUrl      String?
  // True when dealUrl points at the specific item (not just the weekly ad).
  isItemUrl    Boolean  @default(false)
  // Sponsor deals: weekly = +7d, monthly = +30d. Null = lives with its week.
  expiresAt    DateTime?
  // Manual/evergreen deals: any business Chad finds (no per-retailer obligation).
  businessName String?
  validFrom    String?
  validTo      String?
  isTopPick    Boolean   @default(false)
  sortOrder    Int       @default(0)

  @@unique([id, workspaceId])
  @@index([workspaceId, dealWeekId])
}

// Log of weekly buyer-digest sends (one row per send per workspace).
model DealDigestSend {
  workspaceId    String    @default("decatur")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String    @id @default(cuid())
  sentAt         DateTime  @default(now())
  subject        String
  recipientCount Int       @default(0)
  // JSON array of DealWeek ids included in this send.
  dealWeekIds    String    @default("[]")

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// Post-signup Deals nurture sequence: one row per touch sent to a subscriber.
// The cron walks new subscribers through touches 1-4 until they buy the book,
// opt out of the sequence, or unsubscribe.
model DealsNurtureTouch {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String    @id @default(cuid())
  subscriberId String
  email        String
  touch        Int       // 1..4
  sentAt       DateTime  @default(now())

  @@unique([workspaceId, subscriberId, touch])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// Gist Board: community classifieds anyone can post for a flat $5.
// Flow: form -> Stripe Checkout ($5) -> webhook marks pending_approval ->
// admin one-tap approve -> active for 7 days (approvedAt -> expiresAt).
// Live posts render in the newsletter board section and on /board.
// Expiry is time-based in queries (no cron): active + expiresAt in future.
// A rejected paid post is refunded via Stripe at reject time.
model BoardPost {
  workspaceId         String    @default("decatur")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                  String    @id @default(cuid())
  title               String
  description         String
  category            String // for_sale | job | event | announcement | service | wanted
  intent              String? // event | deal | job | celebration | classified (what the poster picked)
  linkUrl             String?
  contactInfo         String?
  displayName         String?
  email               String
  status              String    @default("pending_payment") // pending_payment | pending_approval | active | rejected
  amountCents         Int       @default(500)
  stripeSessionId     String?   @unique
  stripePaymentIntent String?
  paidAt              DateTime?
  approvedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, approvedAt])
}

model Mini {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  slug        String
  title       String
  question    String
  content     Json
  priceCents  Int      @default(500)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  purchases   MiniPurchase[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model MiniPurchase {
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String   @id @default(cuid())
  email           String
  miniId          String
  mini            Mini     @relation(fields: [miniId], references: [id], onDelete: Restrict)
  stripeSessionId String?  @unique
  magicToken      String   @unique @default(cuid())
  upgradedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([workspaceId, email])
  @@index([workspaceId, miniId])
}
