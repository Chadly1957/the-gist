generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                          String                    @id @default(cuid())
  slug                        String                    @unique
  name                        String
  area                        String
  domain                      String?                   @unique
  latitude                    Float?
  longitude                   Float?
  timezone                    String?
  primaryColor                String                    @default("#15803d")
  secondaryColor              String                    @default("#166534")
  logoUrl                     String?
  heroImageUrl                String?
  dealsLogoUrl                String?
  dealsEmailHeaderUrl         String?
  createdAt                   DateTime                  @default(now())
  sourceRows                  Source[]
  articleRows                 Article[]
  templateRows                Template[]
  subscriberRows              Subscriber[]
  settingRows                 Setting[]
  newsletterSendRows          NewsletterSend[]
  newsletterSendSpotlightRows NewsletterSendSpotlight[]
  newsletterRecipientRows     NewsletterRecipient[]
  linkClickRows               LinkClick[]
  sponsorProfileRows          SponsorProfile[]
  spotlightListingRows        SpotlightListing[]
  adBookingRows               AdBooking[]
  sponsorWeekRows             SponsorWeek[]
  sponsorHoldRows             SponsorHold[]
  sponsorWeekBookingRows      SponsorWeekBooking[]
  sponsorDayConfigRows        SponsorDayConfig[]
  gameSponsorEventRows        GameSponsorEvent[]
  eventRows                   Event[]
  referralSprintRows          ReferralSprint[]
  referralCodeRows            ReferralCode[]
  referralSignupRows          ReferralSignup[]
  wordyWordRows               WordyWord[]
  wordyBookingRows            WordyBooking[]
  wordyPlayRows               WordyPlay[]
  matchScoreRows              MatchScore[]
  pollRows                    Poll[]
  pollOptionRows              PollOption[]
  pollVoteRows                PollVote[]
  tipRows                     Tip[]
  couponBookPurchaseRows      CouponBookPurchase[]
  couponRows                  Coupon[]
  couponRedemptionRows        CouponRedemption[]
  retailerRows                Retailer[]
  dealWeekRows                DealWeek[]
  dealRows                    Deal[]
  dealDigestSendRows          DealDigestSend[]
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Source {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  name        String
  url         String
  active      Boolean   @default(true)
  keywords    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, url])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Article {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  articleUrl  String
  sourceName  String
  publishedAt DateTime
  scrapedAt   DateTime  @default(now())
  selected    Boolean   @default(false)
  tags        String[]  @default([])

  @@unique([workspaceId, articleUrl])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Template {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  name        String
  blocks      String // JSON array of block objects
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Subscriber {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String    @id @default(cuid())
  email        String
  firstName    String?
  subscribedAt DateTime  @default(now())
  active       Boolean   @default(true)

  @@unique([workspaceId, email])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Setting {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  key         String
  value       String

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model NewsletterSend {
  workspaceId            String                    @default("decatur")
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                     String                    @id @default(cuid())
  subject                String
  htmlBody               String
  htmlSnapshot           String?
  sentAt                 DateTime                  @default(now())
  recipientCount         Int                       @default(0)
  status                 String                    @default("sent")
  sponsorAnalyticsSentAt DateTime?
  recipients             NewsletterRecipient[]
  spotlightAppearances   NewsletterSendSpotlight[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model NewsletterSendSpotlight {
  workspaceId      String           @default("decatur")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String           @id @default(cuid())
  newsletterSendId String
  newsletterSend   NewsletterSend   @relation(fields: [newsletterSendId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  spotlightId      String
  spotlight        SpotlightListing @relation(fields: [spotlightId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([newsletterSendId])
  @@index([spotlightId])
  @@index([workspaceId])
}

model NewsletterRecipient {
  workspaceId      String         @default("decatur")
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String         @id @default(cuid())
  newsletterSendId String
  newsletterSend   NewsletterSend @relation(fields: [newsletterSendId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  subscriberId     String?
  email            String
  resendEmailId    String?
  openedAt         DateTime?
  openCount        Int            @default(0)
  clickedAt        DateTime?
  clickCount       Int            @default(0)
  unsubscribedAt   DateTime?
  createdAt        DateTime       @default(now())
  clicks           LinkClick[]

  @@unique([id, workspaceId])
  @@index([newsletterSendId])
  @@index([workspaceId])
}

model LinkClick {
  workspaceId           String              @default("decatur")
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                    String              @id @default(cuid())
  newsletterRecipientId String
  newsletterRecipient   NewsletterRecipient @relation(fields: [newsletterRecipientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  url                   String
  linkType              String // article | button | spotlight | presenting_sponsor | in_article_ad
  label                 String?
  createdAt             DateTime            @default(now())

  @@unique([id, workspaceId])
  @@index([newsletterRecipientId])
  @@index([workspaceId])
}

model SponsorProfile {
  workspaceId   String               @default("decatur")
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id            String               @id @default(cuid())
  businessName  String
  contactName   String
  email         String
  phone         String?
  website       String?
  magicToken    String               @unique @default(cuid())
  active        Boolean              @default(true)
  notes         String?
  createdAt     DateTime             @default(now())
  spotlights    SpotlightListing[]
  bookings      AdBooking[]
  weekBookings  SponsorWeekBooking[]
  events        Event[]
  wordyBookings WordyBooking[]
  coupons       Coupon[]
  retailers     Retailer[]

  @@unique([id, workspaceId])
  // One person can own several businesses: email alone is not unique.
  // Find-or-create flows match on email + business name.
  @@index([workspaceId, email])
  @@index([workspaceId])
}

model SpotlightListing {
  workspaceId        String                    @default("decatur")
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                 String                    @id @default(cuid())
  sponsorId          String
  sponsor            SponsorProfile            @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  businessName       String
  logoUrl            String?
  description        String
  ctaLabel           String                    @default("Visit Website")
  ctaUrl             String
  status             String                    @default("pending")
  lastShownAt        DateTime?
  shownCount         Int                       @default(0)
  upgradeNudgeSentAt DateTime?
  createdAt          DateTime                  @default(now())
  approvedAt         DateTime?
  sendAppearances    NewsletterSendSpotlight[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model AdBooking {
  workspaceId          String              @default("decatur")
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                   String              @id @default(cuid())
  sponsorId            String
  sponsor              SponsorProfile      @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  type                 String
  date                 String
  status               String              @default("pending_review")
  isPaid               Boolean             @default(false)
  // $0 comp/house placement (spec section 12). Marked in admin only; the
  // newsletter renders it like any other ad.
  isComp               Boolean             @default(false)
  discountPct          Int                 @default(0)
  stripeSessionId      String?
  imageUrl             String?
  headline             String
  body                 String
  ctaUrl               String
  ctaLabel             String              @default("Learn More")
  presentingBlurb      String?
  adminNotes           String?
  // Set when this row was projected from a week-based SponsorWeekBooking.
  sponsorWeekBookingId String?
  sponsorWeekBooking   SponsorWeekBooking? @relation(fields: [sponsorWeekBookingId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  approvedAt           DateTime?
  gameSponsorEvents    GameSponsorEvent[]

  @@unique([id, workspaceId])
  @@index([stripeSessionId])
  @@index([workspaceId])
  @@index([sponsorWeekBookingId])
}

model SponsorDayConfig {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  date         String // YYYY-MM-DD of the newsletter issue
  maxInArticle Int       @default(2) // per-issue standard-slot override (soft cap)
  createdAt    DateTime  @default(now())

  @@id([workspaceId, date])
  @@index([workspaceId])
}

// Week-based sponsor packages (Presenting $150/wk, Standard $75/wk).
// One row per calendar week (Monday date string); the row doubles as the
// lock target for atomic slot assignment (SELECT ... FOR UPDATE).
model SponsorWeek {
  workspaceId String               @default("decatur")
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String               @id @default(cuid())
  weekStart   String // Monday, YYYY-MM-DD
  createdAt   DateTime             @default(now())
  holds       SponsorHold[]
  bookings    SponsorWeekBooking[]

  @@unique([workspaceId, weekStart])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// Short-lived slot reservation while the buyer fills the business form.
model SponsorHold {
  workspaceId String      @default("decatur")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String      @id @default(cuid())
  weekId      String
  week        SponsorWeek @relation(fields: [weekId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tier        String // "presenting" | "standard"
  holdToken   String      @unique @default(cuid())
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([expiresAt])
}

model SponsorWeekBooking {
  workspaceId            String         @default("decatur")
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                     String         @id @default(cuid())
  weekId                 String
  week                   SponsorWeek    @relation(fields: [weekId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sponsorId              String
  sponsor                SponsorProfile @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tier                   String // "presenting" | "standard"
  status                 String         @default("pending_payment") // pending_payment -> paid -> completed | cancelled
  amountCents            Int
  stripeSessionId        String?
  businessName           String
  contactName            String
  email                  String
  website                String?
  logoUrl                String
  aboutText              String
  chadWritesCopy         Boolean        @default(true)
  finalAdCopy            String?
  copyFinalizedAt        DateTime?
  rebookToken            String         @unique @default(cuid())
  resultsSentAt          DateTime?
  renewalSentAt          DateTime?
  paidAt                 DateTime?
  ownerNotifiedAt        DateTime?
  buyerNotifiedAt        DateTime?
  fulfillmentAlertSentAt DateTime?
  createdAt              DateTime       @default(now())
  adBookingRows          AdBooking[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([stripeSessionId])
  @@index([weekId])
  @@index([status])
}

model GameSponsorEvent {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  game        String // "wordy" | "match"
  eventType   String // "impression" | "click"
  bookingId   String
  booking     AdBooking @relation(fields: [bookingId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([date])
  @@index([bookingId])
  @@index([game])
  @@index([workspaceId])
}

model Event {
  workspaceId String          @default("decatur")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String          @id @default(cuid())
  title       String
  description String?
  eventDate   String
  startTime   String?
  endTime     String?
  location    String?
  url         String?
  cost        String?
  status      String          @default("pending")
  sponsorId   String?
  sponsor     SponsorProfile? @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  approvedAt  DateTime?

  @@unique([id, workspaceId])
  @@index([sponsorId])
  @@index([workspaceId])
}

model ReferralSprint {
  workspaceId      String           @default("decatur")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String           @id @default(cuid())
  name             String
  startDate        String
  endDate          String
  goal             Int              @default(5)
  prizeDescription String?
  status           String           @default("active")
  winnerEmail      String?
  drawnAt          DateTime?
  createdAt        DateTime         @default(now())
  signups          ReferralSignup[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model ReferralCode {
  workspaceId  String           @default("decatur")
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String           @id @default(cuid())
  subscriberId String           @unique
  code         String           @unique
  createdAt    DateTime         @default(now())
  signups      ReferralSignup[]

  @@unique([id, workspaceId])
  @@index([code])
  @@index([workspaceId])
}

model ReferralSignup {
  workspaceId     String          @default("decatur")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String          @id @default(cuid())
  referralCodeId  String
  referralCode    ReferralCode    @relation(fields: [referralCodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  newSubscriberId String?
  sprintId        String?
  sprint          ReferralSprint? @relation(fields: [sprintId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdAt       DateTime        @default(now())

  @@unique([id, workspaceId])
  @@index([referralCodeId])
  @@index([sprintId])
  @@index([workspaceId])
}

model WordyWord {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  word        String
  puzzleNum   Int?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, date])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model WordyBooking {
  workspaceId     String         @default("decatur")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String         @id @default(cuid())
  date            String
  sponsorId       String
  sponsor         SponsorProfile @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  headline        String
  body            String         @default("")
  ctaUrl          String         @default("")
  ctaLabel        String         @default("Learn More")
  imageUrl        String?
  presentingBlurb String?
  status          String         @default("pending_review")
  isPaid          Boolean        @default(false)
  stripeSessionId String?
  adminNotes      String?
  createdAt       DateTime       @default(now())
  approvedAt      DateTime?

  @@unique([workspaceId, date])
  @@unique([id, workspaceId])
  @@index([sponsorId])
  @@index([stripeSessionId])
  @@index([workspaceId])
}

model WordyPlay {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  recipientId String?
  won         Boolean
  guesses     Int
  maxGuesses  Int
  wordLength  Int
  createdAt   DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([date])
  @@index([workspaceId])
}

model MatchScore {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  date        String
  deviceId    String
  name        String
  score       Int
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, date, deviceId])
  @@unique([id, workspaceId])
  @@index([date])
  @@index([workspaceId])
}

model Poll {
  workspaceId      String       @default("decatur")
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  question         String
  newsletterSendId String?
  createdAt        DateTime     @default(now())
  options          PollOption[]
  votes            PollVote[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model PollOption {
  workspaceId String     @default("decatur")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  label       String
  sortOrder   Int        @default(0)
  votes       PollVote[]

  @@unique([id, workspaceId])
  @@index([pollId])
  @@index([workspaceId])
}

model PollVote {
  workspaceId String     @default("decatur")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  optionId    String
  option      PollOption @relation(fields: [optionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  recipientId String?
  createdAt   DateTime   @default(now())

  @@unique([pollId, recipientId])
  @@unique([id, workspaceId])
  @@index([pollId])
  @@index([optionId])
  @@index([workspaceId])
}

model Tip {
  workspaceId     String    @default("decatur")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String    @id @default(cuid())
  amountCents     Int
  source          String    @default("web") // "web" | "newsletter" | "wordy" | "match"
  status          String    @default("pending_payment") // pending_payment | paid
  stripeSessionId String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@unique([id, workspaceId])
  @@index([stripeSessionId])
  @@index([status])
  @@index([workspaceId])
}

model CouponBookPurchase {
  workspaceId     String             @default("decatur")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id              String             @id @default(cuid())
  email           String
  stripeSessionId String?            @unique
  // Unguessable token encoded in the buyer's QR code; the cashier page needs
  // no login, so this token is the only credential. Keep it private.
  buyerToken      String             @unique @default(cuid())
  // Emailed magic link for the reader dashboard (no passwords).
  magicToken      String             @unique @default(cuid())
  active          Boolean            @default(true)
  // Lifetime access: one-time $15 buyers are grandfathered in free if the book
  // ever moves to a subscription. All one-time purchases get this.
  isLifetime      Boolean            @default(true)
  // Weekly deals digest: buyers get the fresh book in their inbox every week
  // unless they opt out (footer link in each digest).
  digestOptOut    Boolean            @default(false)
  createdAt       DateTime           @default(now())
  redemptions     CouponRedemption[]

  @@unique([id, workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId])
}

model Coupon {
  workspaceId    String             @default("decatur")
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String             @id @default(cuid())
  businessName   String
  title          String
  description    String             @default("")
  terms          String             @default("")
  // 1 = one-time use, null = unlimited recurring. Enforced server-side.
  maxRedemptions Int?
  // Renewing coupon: "daily" | "weekly" | "monthly" — one redemption per interval,
  // auto-refreshes. Null = legacy maxRedemptions behavior.
  refreshInterval String?
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  contactEmail   String?
  createdAt      DateTime           @default(now())
  redemptions    CouponRedemption[]
  // Self-serve portal submission: null = created by admin in the coupon book flow.
  sponsorId      String?
  sponsor        SponsorProfile?    @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model CouponRedemption {
  workspaceId String             @default("decatur")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String             @id @default(cuid())
  couponId    String
  coupon      Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    CouponBookPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime           @default(now())
  // Optional note the cashier adds at scan time (new per-coupon QR flow).
  notes       String             @default("")

  @@unique([id, workspaceId])
  @@index([couponId])
  @@index([purchaseId])
  @@index([workspaceId])
}

// Coupon book content engine: weekly retailer deals (Phase 1).
// Retailers are configured per workspace; national content (Hobby Lobby) is
// seeded per workspace too so the unique constraints stay uniform.
model Retailer {
  workspaceId          String     @default("decatur")
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id                   String     @id @default(cuid())
  slug                 String
  displayName          String
  // Retailer brand logo for the Deals Book bento UI (Chad approved using brand logos).
  logoUrl              String?
  // Self-serve sponsor deals: null = Chad-managed retailer, set = this sponsor's own deals section.
  sponsorId            String?
  sponsor              SponsorProfile? @relation(fields: [sponsorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // hobby-lobby | target | aldi | dollar-general | kroger | manual
  pipeline             String
  // JSON: { zip, storeId, locationId } — whatever the pipeline needs.
  storeConfig          String     @default("{}")
  affiliateUrlTemplate String?
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())
  dealWeeks            DealWeek[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model DealWeek {
  workspaceId String    @default("decatur")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  retailerId  String
  retailer    Retailer  @relation(fields: [retailerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  weekStart   String // YYYY-MM-DD (Monday)
  weekEnd     String
  sourceUrl   String?
  // draft | published
  status      String    @default("draft")
  fetchedAt   DateTime  @default(now())
  publishedAt DateTime?
  deals       Deal[]

  @@unique([workspaceId, retailerId, weekStart])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

model Deal {
  workspaceId  String    @default("decatur")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id           String    @id @default(cuid())
  dealWeekId   String
  dealWeek     DealWeek  @relation(fields: [dealWeekId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Our own wording — prices/facts aren't copyrightable, but we paraphrase
  // retailer headlines rather than copying ad copy verbatim.
  title        String
  price        String?
  regPrice     String?
  category     String?
  summary      String    @default("")
  // Deep link to the retailer's own ad page for this deal/week.
  dealUrl      String?
  // True when dealUrl points at the specific item (not just the weekly ad).
  isItemUrl    Boolean  @default(false)
  // Sponsor deals: weekly = +7d, monthly = +30d. Null = lives with its week.
  expiresAt    DateTime?
  // Manual/evergreen deals: any business Chad finds (no per-retailer obligation).
  businessName String?
  validFrom    String?
  validTo      String?
  isTopPick    Boolean   @default(false)
  sortOrder    Int       @default(0)

  @@unique([id, workspaceId])
  @@index([workspaceId, dealWeekId])
}

// Log of weekly buyer-digest sends (one row per send per workspace).
model DealDigestSend {
  workspaceId    String    @default("decatur")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id             String    @id @default(cuid())
  sentAt         DateTime  @default(now())
  subject        String
  recipientCount Int       @default(0)
  // JSON array of DealWeek ids included in this send.
  dealWeekIds    String    @default("[]")

  @@unique([id, workspaceId])
  @@index([workspaceId])
}
